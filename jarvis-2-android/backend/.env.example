# JARVIS backend configuration — placeholders only
PORT=8787
JARVIS_API_TOKEN=replace-with-a-long-random-backend-token
CORS_ORIGIN=*
JARVIS_STATE_FILE=./jarvis-state.json

# OpenAI — real key must remain server-side only
OPENAI_API_KEY=replace-with-server-secret
OPENAI_MODEL=gpt-5.6-terra
OPENAI_MODEL_FAST=gpt-5.6-luna
OPENAI_MODEL_COMPLEX=gpt-5.6-sol
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe

# Optional integrations
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
